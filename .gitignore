__pycache__/
*.pyc

# ── THE HELD-OUT SET MUST NEVER BE COMMITTED ────────────────────────────────
# holdout.json is the private half of the benchmark. Its whole value is that no
# model has seen it. One commit destroys it permanently and irreversibly — there
# is no un-publishing a git object.
#
# holdout-manifest.json IS committed on purpose: it pins the set's shape and
# SHA-256 in public so a later release can be verified, without revealing a
# single question. See CANARY.md.
#
# A CI job (.github/workflows/holdout-guard.yml) fails the build if this file
# ever becomes tracked. Do not "temporarily" add it to check something.
holdout.json

# Generated by hf/build.py — rebuildable from the repo, so it is not tracked.
# It is also the directory an upload reads from, which is why hf/push.py
# re-checks it for held-out ids rather than trusting this file to stay clean.
hf/data/

# Regenerated by each search-arm run; the committed artefact is the SCORED
# result, not the raw answers, which are published with the study instead.
search_results.json
